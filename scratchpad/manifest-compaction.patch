@@ -51,3 +52,53 @@ test('a live folder is never shadowed by another folder’s alias', () => {
   assert.equal(bySlug.get('charitina-the-martyr-4-september'), live);
   assert.equal(byAlias.size, 0);
 });
+
+/*
+ * **The image is rehydrated here because here is the only door.** The manifest
+ * stores `{ w, h }` to stay under the gzip budget (see `src/lib/image-shape.js`
+ * for the measurement), and every view reaches a card through `indexManifest`,
+ * so the ~30 call sites that read `card.image.lqip` or `card.image.cardSmW`
+ * never learn that the file did not contain them.
+ */
+test('an iconed card is handed the full image object, derived from its slug', () => {
+  const { bySlug } = indexManifest([card('anthony-the-great', { image: { w: 939, h: 625 } })]);
+  assert.deepEqual(bySlug.get('anthony-the-great').image, hydrateImage('anthony-the-great', { w: 939, h: 625 }));
+});
+
+/*
+ * **Lazily, which is the half with the cost in it.** Hydrating every iconed
+ * card up front would build five strings each for hundreds of cards between
+ * the fetch resolving and the first paint — on the path the paint waits for —
+ * to serve the dozen a screenful shows. So the property is a getter that
+ * materialises once and then is the value.
+ */
+test('the image object is built on first read, once, and not before', () => {
+  let built = 0;
+  const probe = { slug: 'probe', display_name: 'probe', image: { w: 4, h: 3 } };
+  const { bySlug } = indexManifest([probe]);
+  const desc = Object.getOwnPropertyDescriptor(probe, 'image');
+  assert.equal(typeof desc.get, 'function', 'the image was hydrated eagerly');
+  assert.equal(desc.value, undefined);
+
+  // Reading it twice must give the same object, not two equal ones: the
+  // grid compares `item.image` identities across frames.
+  const once = bySlug.get('probe').image;
+  built += 1;
+  assert.equal(bySlug.get('probe').image, once);
+  assert.equal(built, 1);
+  assert.equal(typeof Object.getOwnPropertyDescriptor(probe, 'image').get, 'undefined');
+});
+
+// The eight call sites that only ask whether there is a picture — the carousel's
+// cell packer, the calendar's hero pick, the map's label weighting — test the
+// property for truth, and a getter answers that without being read specially.
+test('a card with no image keeps its falsy one, and an iconed card stays truthy', () => {
+  const { bySlug } = indexManifest([
+    card('plain', { image: null }),
+    card('bare'),
+    card('iconed', { image: { w: 4, h: 3 } }),
+  ]);
+  assert.equal(bySlug.get('plain').image, null);
+  assert.equal(bySlug.get('bare').image, undefined);
+  assert.ok(bySlug.get('iconed').image);
+});
