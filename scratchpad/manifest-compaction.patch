  *   card that claims it
@@ -37,11 +46,36 @@ export function indexManifest(manifest) {
   const bySlug = new Map(manifest.map((s) => [s.slug, s]));
   const byAlias = new Map();
   for (const card of manifest) {
+    if (card.image) defineImage(card);
     for (const alias of card.aliases ?? []) if (!bySlug.has(alias)) byAlias.set(alias, card);
   }
   return { saints: manifest, bySlug, byAlias };
 }
 
+/**
+ * **Lazily**, and that is the whole point of doing it here rather than in a
+ * `map`. Hydrating eagerly would build five strings for each of the hundreds
+ * of iconed cards between the fetch resolving and the first paint, on the path
+ * that paint is waiting for, to serve the dozen cards a screenful shows. The
+ * getter replaces itself with the value on first read, so a card drawn twice
+ * pays once and a card never drawn pays nothing.
+ *
+ * `card.image` stays truthy either way, which is what the eight call sites
+ * that only ask whether there is a picture are testing.
+ */
+function defineImage(card) {
+  const stored = card.image;
+  Object.defineProperty(card, 'image', {
+    configurable: true,
+    enumerable: true,
+    get() {
+      const image = hydrateImage(card.slug, stored);
+      Object.defineProperty(card, 'image', { value: image, configurable: true, enumerable: true, writable: true });
+      return image;
+    },
+  });
+}
