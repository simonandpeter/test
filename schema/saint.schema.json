{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gallery-of-saints/schema/saint.schema.json",
  "title": "Saint",
  "description": "One saint as one entity with N per-church attestations. There is no merged row and no single truth: a figure venerated by one church and refused by another carries both, side by side, unresolved.",
  "type": "object",
  "required": ["slug", "display_name", "attestations"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Permanent id. Must equal the folder name."
    },
    "display_name": { "type": "string", "minLength": 1 },
    "names": { "type": "array", "items": { "$ref": "#/$defs/name" } },
    "sex": { "enum": ["male", "female", "unknown"] },
    "types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "dates": { "$ref": "#/$defs/dates" },
    "attestations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attestation" }
    },
    "locations": { "type": "array", "items": { "$ref": "#/$defs/location" } },
    "historicity": { "enum": ["attested", "traditional", "disputed", "legendary"] },
    "related": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "life": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "images": { "type": "array", "items": { "$ref": "#/$defs/image" } }
  },

  "$defs": {
    "name": {
      "type": "object",
      "required": ["form"],
      "additionalProperties": false,
      "properties": {
        "form": { "type": "string", "minLength": 1 },
        "lang": { "type": "string", "minLength": 2 },
        "note": { "type": "string" }
      }
    },

    "interval": {
      "description": "Every date is an interval. A precise date has equal bounds. A null bound is an open bound — a real finding, such as 'no later than 550' — and is not the same as an absent date.",
      "type": ["object", "null"],
      "required": ["basis"],
      "additionalProperties": false,
      "properties": {
        "earliest": { "type": ["integer", "null"] },
        "latest": { "type": ["integer", "null"] },
        "display": { "type": ["string", "null"] },
        "basis": { "enum": ["attested", "traditional", "inferred", "unknown"] },
        "note": { "type": "string" }
      }
    },

    "dates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "birth": { "$ref": "#/$defs/interval" },
        "death": { "$ref": "#/$defs/interval" },
        "floruit": { "$ref": "#/$defs/interval" }
      }
    },

    "source": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "year": { "type": "integer" },
        "url": { "type": "string", "format": "uri" },
        "note": { "type": "string" }
      }
    },

    "feast": {
      "oneOf": [
        {
          "type": "object",
          "required": ["day", "month", "calendar"],
          "additionalProperties": false,
          "properties": {
            "day": { "type": "integer", "minimum": 1, "maximum": 31 },
            "month": { "type": "integer", "minimum": 1, "maximum": 13 },
            "calendar": { "enum": ["gregorian", "julian", "coptic", "ethiopian"] },
            "note": { "type": "string" }
          }
        },
        {
          "description": "Movable feast, as a signed day offset from Pascha. The computus is taken from the church unless stated here.",
          "type": "object",
          "required": ["calendar", "offset"],
          "additionalProperties": false,
          "properties": {
            "calendar": { "const": "paschal" },
            "offset": { "type": "integer", "minimum": -200, "maximum": 200 },
            "computus": { "enum": ["gregorian", "julian"] },
            "note": { "type": "string" }
          }
        }
      ]
    },

    "attestation": {
      "type": "object",
      "required": ["church", "status"],
      "additionalProperties": false,
      "properties": {
        "church": { "type": "string", "minLength": 1 },
        "status": { "enum": ["venerated", "not-venerated", "undocumented"] },
        "feast": { "$ref": "#/$defs/feast" },
        "titles": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/source" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "$comment": "A veneration and a refusal are both positive findings and both need a citation. Only 'undocumented' — we have not looked, or looked and found nothing — may stand without one, which is exactly what makes it different from a refusal.",
          "if": {
            "required": ["status"],
            "properties": { "status": { "enum": ["venerated", "not-venerated"] } }
          },
          "then": { "required": ["source"] }
        },
        {
          "$comment": "A feast day is a claim about veneration and cannot be attached to a refusal or a gap.",
          "if": {
            "required": ["status"],
            "properties": { "status": { "enum": ["not-venerated", "undocumented"] } }
          },
          "then": { "not": { "required": ["feast"] } }
        }
      ]
    },

    "location": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "dependentRequired": {
        "lat": ["lon", "uncertainty_km"],
        "lon": ["lat"],
        "uncertainty_km": ["lat"]
      },
      "properties": {
        "kind": { "enum": ["birth", "death", "ministry", "relics", "see"] },
        "historical_name": { "type": "string" },
        "modern_name": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "uncertainty_km": {
          "description": "Radius of uncertainty in kilometres — a number, not an enum, so halos, cluster thresholds and label logic are one continuous function of one field (Addendum B1). Authoring defaults: pinpointed site 1, city 15, region 150, 'somewhere in this province' 500. Required whenever coordinates are present.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "note": { "type": "string" }
      }
    },

    "image": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "meta": { "type": "string" }
      }
    }
  }
}
