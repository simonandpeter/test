{
  "name": "the-orthodox-saint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:manifest": "node scripts/build-manifest.mjs",
    "validate": "node scripts/validate.mjs",
    "new-saint": "node scripts/new-saint.mjs",
    "thumbs": "python make_thumbs.py",
    "fonts": "node scripts/fetch-fonts.mjs && node scripts/font-metrics.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop --workers=10",
    "test:e2e:mobile": "playwright test --project=mobile-360 --workers=10",
    "test:lighthouse": "node scripts/lighthouse-floor.mjs",
    "test:all": "npm test && npm run test:e2e",
    "dev": "npm run build:manifest && vite",
    "build": "npm run build:manifest && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chrome-launcher": "^1.2.1",
    "image-size": "^2.0.2",
    "lighthouse": "^13.4.1",
    "topojson-client": "^3.1.0",
    "vite": "^7.1.3",
    "world-atlas": "^2.0.2"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "minisearch": "^7.2.0"
  }
}
