{
  "name": "the-orthodox-saint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:manifest": "node scripts/build-manifest.mjs",
    "build:texts": "node scripts/build-texts.mjs",
    "validate": "node scripts/validate.mjs",
    "new-saint": "node scripts/new-saint.mjs",
    "thumbs": "python make_thumbs.py",
    "fonts": "node scripts/fetch-fonts.mjs && node scripts/font-metrics.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop --workers=10",
    "test:e2e:mobile": "playwright test --project=mobile-360 --workers=10",
    "test:lighthouse": "node scripts/lighthouse-floor.mjs",
    "test:all": "npm test && npm run test:e2e",
    "dev": "npm run build:manifest && npm run build:texts && vite",
    "build": "npm run build:manifest && npm run build:texts && vite build",
    "preview": "vite preview",
    "app:icons": "python scripts/make-app-icons.py && capacitor-assets generate --android --ios --iconBackgroundColor #ece5d6 --iconBackgroundColorDark #1a1412 --splashBackgroundColor #ece5d6 --splashBackgroundColorDark #1a1412",
    "app:sync": "npm run build && cap sync",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@playwright/test": "^1.62.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chrome-launcher": "^1.2.1",
    "image-size": "^2.0.2",
    "lighthouse": "^13.4.1",
    "topojson-client": "^3.1.0",
    "vite": "^7.1.3",
    "world-atlas": "^2.0.2"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "idb": "^8.0.3",
    "minisearch": "^7.2.0"
  }
}
